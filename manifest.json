{
  "manifest_version": 3,
  "name": "Lichess Figurensets",
  "version": "1.0.0",
  "description": "Figurensets, Brettfarben und weitere Lichess-Anpassungen mit zentralen Einstellungen.",
  "permissions": ["storage", "downloads", "clipboardWrite", "unlimitedStorage", "offscreen"],
  "host_permissions": ["https://lichess.org/*"],
  "icons": {
    "128": "extension-icon.png"
  },
  "action": {
    "default_title": "Lichess Figurensets",
    "default_icon": "extension-icon.png",
    "default_popup": "popup.html"
  },
  "options_page": "options.html",
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://lichess.org/*"],
      "css": ["extension.css"],
      "js": ["colors.js", "settings.js", "sound-catalog.js", "board-overlay.js", "last-move-line.js", "threat-coding.js", "king-movement-fields.js", "piece-bounce.js", "move-animation.js", "highlight-line-preview.js", "selected-piece-wedge.js", "puzzle-scheduler.js", "puzzle-playlist.js", "blunder-list.js", "content.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://lichess.org/*"],
      "js": ["colors.js", "graph.js", "move-animation-main.js", "sounds-main.js", "blunder-training-main.js"],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "system_pixel/*.svg",
        "system_eckig/*.svg",
        "system_rund/*.svg",
        "rund/*.svg",
        "rund_comic/*.svg",
        "cage/*.svg",
        "sounds/*.wav"
      ],
      "matches": ["https://lichess.org/*"]
    }
  ]
}
